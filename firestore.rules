rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read: books and their risale subcollections
    match /books/{bookId} {
      allow read: if true;
      match /risales/{risaleId} {
        allow read: if true;
      }
    }

    // Per-user data: only the signed-in user can read/write their own documents
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

  }
}
